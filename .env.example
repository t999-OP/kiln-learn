# Kiln configuration. Copy to .env and adjust. Every variable is optional for local development.

# Postgres connection. Without it, Kiln uses an embedded Postgres (PGlite) in ./data/pglite —
# fine for trying it out or small instances; use real Postgres in production.
# DATABASE_URL=postgres://kiln:kiln@localhost:5432/kiln
# DATABASE_POOL=10

# Secret used to encrypt users' AI API keys. REQUIRED in production; keep it stable and backed up
# (changing it makes stored keys unreadable). Generate one with: openssl rand -base64 32
# KILN_SECRET=

# Public URL of the app (adapter-node uses it for CSRF checks behind a proxy).
# ORIGIN=https://kiln.example.com
# PORT=3000

# Interactive widgets run on a separate origin for isolation. Kiln serves it on WIDGET_PORT.
# Behind a reverse proxy, route a second hostname to that port and set WIDGET_ORIGIN.
# WIDGET_PORT=3001
# WIDGET_ORIGIN=https://widgets.kiln.example.com

# Instance name shown in the UI.
# KILN_NAME=Kiln

# "open" (anyone can sign up) or "closed" (no self sign-up).
# KILN_REGISTRATION=open

# Who may point AI features at custom server URLs (Ollama, self-hosted models): all | admins | none.
# Custom URLs make the server send requests to arbitrary addresses, so the default is admins.
# KILN_AI_CUSTOM_URLS=admins
# KILN_AI_HOURLY_LIMIT=30

# Import the example courses on first start (set to false for an empty instance).
# KILN_SEED=true

# Footer links. Many EU operators must publish an imprint and privacy policy.
# KILN_IMPRINT_URL=
# KILN_PRIVACY_URL=

# Used by docker-compose.yml for the bundled Postgres.
# POSTGRES_PASSWORD=

# Only this email becomes admin when it signs up (otherwise the first account does).
# KILN_ADMIN_EMAIL=you@example.com

# Behind a reverse proxy, tell Kiln which header has the client IP (for rate limiting).
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Where your instance's source code is published (AGPL-3.0: link your fork if you modify Kiln).
# KILN_SOURCE_URL=https://github.com/t999-OP/kiln-learn
